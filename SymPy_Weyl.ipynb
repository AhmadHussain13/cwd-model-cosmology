import sympy as sp

# Define real, positive symbols
r, y, M5, L = sp.symbols('r y M5 L', positive=True)
kappa5 = sp.Symbol('kappa5', positive=True)
G4 = 6.67430e-11  # Newton's constant (m^3 kg^-1 s^-2)
Mb = sp.Symbol('Mb', positive=True)

# 5D energy density component (E_00)
E00 = kappa5**2 * M5 * sp.exp(-r/L) / L**2
print(f'E_{{00}} = {E00}')
print("Note: Units of E_00 depend on conventions (kappa5). Do not label as kg/m^3 unless defined that way.\n")

# Effective gravitational potential (Phi_eff)
Phi_eff = -G4 * Mb / r - G4 * M5 * (1 + r/L) * sp.exp(-r/L) / (r * L)
print(f'Phi_eff = {Phi_eff}')

# 5D energy density (rho_5) with Dirac delta functions
rho5 = M5 * sp.DiracDelta(y) * sp.DiracDelta(r) / (4 * sp.pi * r**2)
print(f'rho_5 = {rho5}')  # Symbolic; integrate over r, y for M5
print("Note: rho_5 is infinite at r=0, y=0 due to Dirac deltas; integrate to recover M5.\n")

# Laplacian check for Phi_eff (spherical symmetry, smooth part only)
laplacian_smooth = sp.diff(r**2 * sp.diff(Phi_eff, r), r) / r**2
print(f'Laplacian (smooth part) = {laplacian_smooth.simplify()}')

# Explicit delta contributions (manual, since SymPy omits them)
laplacian_full = laplacian_smooth + (-4*sp.pi*G4*Mb*sp.DiracDelta(r)/(4*sp.pi*r**2)) \
                 + (4*sp.pi*G4*M5/L*sp.DiracDelta(r)/(4*sp.pi*r**2))
print(f'Laplacian (full, including deltas) = {laplacian_full}\n')

# Numerical evaluation with confirmed values (in kg)
kappa5_val = 4.24e11       # Adjusted 5D gravitational coupling (m^-1 kg^-1/2)
L_val = 15 * 3.086e19      # AdS radius ~ 15 Mpc in meters
M5_val = 3e41              # Bulk mass ~ 10^11 solar masses (kg)
Mb_val = 1.1934e34         # Brane mass ~ 6e3 solar masses (kg)

E00_num = E00.subs({kappa5: kappa5_val, M5: M5_val, L: L_val, r: 1e19})
Phi_eff_num = Phi_eff.subs({M5: M5_val, Mb: Mb_val, L: L_val, r: 1e19})

print(f'E_00 at r=1e19 m = {E00_num.evalf()} (conventions-dependent units)')
print(f'Phi_eff at r=1e19 m = {Phi_eff_num.evalf()} (~ -7.97e4 m^2/s^2, consistent)\n')