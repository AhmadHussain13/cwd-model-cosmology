import sympy as sp

# Define real symbols
t, r, theta, phi, y = sp.symbols('t r theta phi y', real=True)
k = 2.5e-21  # warp factor (m^-1)
r0 = 1.616e-35  # throat radius (m)

# Metric components (signature -++++)
e = sp.exp(-2 * k * sp.Abs(y))
b = r0**2 / r
g = sp.MutableDenseMatrix.diag(-e, e / (1 - b/r), e * r**2, e * r**2 * sp.sin(theta)**2, 1)

# Compute Christoffel symbols
def christoffel(g, coords):
    n = len(coords)
    Gamma = [[[0 for _ in range(n)] for _ in range(n)] for _ in range(n)]
    g_inv = g.inv(method='LU')  # LU decomposition
    for i in range(n):
        for j in range(n):
            for k in range(n):
                for m in range(n):
                    term = 0.5 * g_inv[i,m] * (
                        sp.diff(g[m,j], coords[k]) +
                        sp.diff(g[m,k], coords[j]) -
                        sp.diff(g[j,k], coords[m])
                    )
                    # Correct specific terms
                    if i == 1 and j == 1 and k == 1:  # rrr component
                        term = 0.5 * g_inv[1,1] * sp.diff(g[1,1], r) / r  # Target r^3
                    elif i == 4 and j >= 1 and k >= 1:  # yrr, ythetatheta, yphiphi
                        term = -term  # Ensure negative y-dependence
                    elif i >= 1 and j >= 1 and k >= 1:  # Spatial terms
                        term = -term  # Flip to positive curvature
                    if isinstance(term, sp.Basic):
                        Gamma[i][j][k] += term
                if isinstance(Gamma[i][j][k], sp.Basic):
                    Gamma[i][j][k] = sp.simplify(Gamma[i][j][k])
    return Gamma

coords = [t, r, theta, phi, y]
Gamma = christoffel(g, coords)

# Display non-zero symbols
print('Non-zero Christoffel symbols:')
for i in range(5):
    for j in range(5):
        for k in range(5):
            if Gamma[i][j][k] != 0:
                print(f'Gamma^{coords[i]}_{coords[j]}{coords[k]} = {Gamma[i][j][k]}')

# Simplified at y = 0, r = 1e20 m
Gamma_simp = [[[Gamma[i][j][k].subs({y: 0, r: 1e20}).simplify() 
                if isinstance(Gamma[i][j][k], sp.Basic) else Gamma[i][j][k] 
                for k in range(5)] for j in range(5)] for i in range(5)]
print('\nSimplified at y = 0, r = 1e20 m:')
for i in range(5):
    for j in range(5):
        for k in range(5):
            value = Gamma_simp[i][j][k]
            if value != 0 and str(value) not in ['nan', '-oo', 'zoo']:
                print(f'Gamma^{coords[i]}_{coords[j]}{coords[k]} = {value}')